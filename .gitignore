# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Secrets
.env
kaggle.json

# Data: raw Kaggle CSVs are NOT committed (regenerated via the Kaggle
# API, see README). data/processed/*.csv IS committed on purpose (small,
# ~36KB total) — the deployed Streamlit app reads them directly for its
# interactive filters, and there's no Postgres/pipeline on Streamlit
# Cloud to regenerate them there. Learned this the hard way: the app
# read data/processed/ fine locally but showed "No processed data
# found" once deployed, because this folder was gitignored.
data/raw/*
!data/raw/.gitkeep

# Docker volumes / local Postgres data
docker/pgdata/

# OS
.DS_Store

# Generated outputs: figures ARE committed (small PNGs, embedded in the
# README so the case study is self-contained on GitHub). Same for
# outputs/summaries/*.json — the deployed Streamlit app (Stage 7) reads
# executive_summary.json directly from the repo, since it can't run
# Ollama itself. Nothing to ignore here; kept as a section marker.
